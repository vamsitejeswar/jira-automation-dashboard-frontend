# Copy to .env.local for local development (gitignored already).

# Set to "true" to use mock data instead of the real backend -- useful for
# UI work with no FastAPI service running. Defaults to the real backend
# (via vite.config.ts's dev proxy, /api -> http://localhost:8000) when unset
# or "false".
VITE_USE_MOCK=false

# Auth is real per-admin Google OAuth now (see app/routers/auth.py on the
# backend) -- the browser signs in via a redirect to the backend's own
# /api/auth/login, and every /api/admin/* call sends the resulting session
# cookie automatically. No token to configure here.

# Real backend URL, only needed when this frontend is deployed somewhere
# that isn't same-origin with the backend (no dev proxy to fall back on).
# Leave blank for local dev (uses vite.config.ts's proxy, /api ->
# http://localhost:8000) or a same-origin production deployment.
VITE_API_BASE_URL=https://verse-jira-onboarding-852267154002.asia-south1.run.app
